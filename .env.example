# Copy to .env for docker compose, or define the same values in Portainer.
# Both host directories must already exist; Compose will not create them.
MIXMILL_MEDIA_PATH=/volume1/media/Mixmill/LM
MIXMILL_DATA_PATH=/volume2/docker/mixmill/data

# Any non-empty password is accepted. Do not commit the real value.
MIXMILL_USERNAME=admin
MIXMILL_PASSWORD=replace-with-your-password

# Port published on the NAS/Docker host. Open http://HOST-IP:2999 by default.
MIXMILL_PORT=2999

# Numeric owner of the dedicated MixMill data directory on the NAS.
MIXMILL_UID=10001
MIXMILL_GID=10001

# Adjust only if large releases need more resources on your NAS.
MIXMILL_MEMORY_LIMIT=4g
MIXMILL_CPU_LIMIT=2.0
MIXMILL_MAX_BODY_BYTES=1048576
MIXMILL_MEDIA_TIMEOUT=3600
# Maximum accepted source choreography PDF size (256 MiB by default).
MIXMILL_MAX_CHOREOGRAPHY_PDF_BYTES=268435456
